generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bank {
  id                                  Int          @id @default(autoincrement())
  bank_name                           String
  account_number                      BigInt
  routing_number                      BigInt
  return_address                      String?
  return_city                         String?
  return_state                        String?
  return_zip                          BigInt?
  account_name                        String?
  dba                                 String?
  signature_name                      String?
  signature_url                       String?
  created_at                          DateTime     @default(now())
  account_type                        String       @default("CHECKING")
  assigned_to_user_id                 Int?
  User_Bank_assigned_to_user_idToUser User?        @relation("Bank_assigned_to_user_idToUser", fields: [assigned_to_user_id], references: [id])
  BankSigner                          BankSigner[]
  Check                               Check[]
  User_User_assigned_bank_idToBank    User[]       @relation("User_assigned_bank_idToBank")
  VendorBank                          VendorBank[]
}

model BankSigner {
  id         Int     @id @default(autoincrement())
  bank_id    Int
  signer_id  Int
  is_default Boolean @default(false)
  Bank       Bank    @relation(fields: [bank_id], references: [id])
  Signer     Signer  @relation(fields: [signer_id], references: [id])

  @@unique([bank_id, signer_id])
}

model Check {
  id                 Int      @id @default(autoincrement())
  check_number       BigInt   @default(autoincrement())
  bank_id            Int
  vendor_id          Int?
  amount             Decimal? @db.Decimal(12, 2)
  payee_name         String?
  memo               String?
  created_at         DateTime @default(now())
  invoice_url        String?
  issued_by_username String?
  Bank               Bank     @relation(fields: [bank_id], references: [id])
  Vendor             Vendor?  @relation(fields: [vendor_id], references: [id])
}

model Signature {
  id          Int      @id @default(autoincrement())
  signer_id   Int
  storage_key String
  url         String
  mime_type   String
  width       Int?
  height      Int?
  uploaded_by Int?
  uploaded_at DateTime @default(now())
  is_active   Boolean  @default(true)
  Signer      Signer   @relation(fields: [signer_id], references: [id])
}

model Signer {
  id         Int          @id @default(autoincrement())
  full_name  String
  user_id    Int?
  created_at DateTime     @default(now())
  BankSigner BankSigner[]
  Signature  Signature[]
}

model User {
  id                                  Int       @id @default(autoincrement())
  username                            String    @unique
  password_hash                       String
  assigned_bank_id                    Int?
  created_at                          DateTime  @default(now())
  role                                Role      @default(USER)
  token_revoked_at                    DateTime?
  Bank_Bank_assigned_to_user_idToUser Bank[]    @relation("Bank_assigned_to_user_idToUser")
  Bank_User_assigned_bank_idToBank    Bank?     @relation("User_assigned_bank_idToBank", fields: [assigned_bank_id], references: [id])
  managedStores                       Store[]
}

model Vendor {
  id             Int          @id @default(autoincrement())
  vendor_name    String
  vendor_type    VendorType
  description    String?
  contact_person String?
  email          String?
  phone          String?
  address        String?
  created_at     DateTime     @default(now())
  updated_at     DateTime
  VendorBank     VendorBank[]
  Check          Check[]
}

model VendorBank {
  id         Int      @id @default(autoincrement())
  vendor_id  Int
  bank_id    Int
  created_at DateTime @default(now())
  Bank       Bank     @relation(fields: [bank_id], references: [id], onDelete: Cascade)
  Vendor     Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@unique([vendor_id, bank_id])
}

model Store {
  id        Int      @id @default(autoincrement())
  name      String
  address   String
  email     String?
  phone     String?
  region    String?
  storeType String?
  photoUrl  String?
  status    String   @default("active")
  managerId Int?
  manager   User?    @relation(fields: [managerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum VendorType {
  MERCHANDISE
  EXPENSE
  EMPLOYEE
}
